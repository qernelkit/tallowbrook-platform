# MariaDB 11: invoicing database (db-inv-ord1)
[client-server]
port = 3306
socket = /run/mysqld/mysqld.sock

[mariadbd]
bind-address = 10.20.6.15
max_connections = 400
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
innodb_buffer_pool_size = 12G
innodb_log_file_size = 2G
innodb_flush_log_at_trx_commit = 1
slow_query_log = ON
long_query_time = 2

# application connections (billing-dotnet, invoice exports)
ssl_cert = /etc/tallowbrook/pki/services/data.crt
ssl_key = /etc/tallowbrook/pki/services/data.key
ssl_ca = /etc/tallowbrook/pki/ca/issuing-ec.crt
tls_version = TLSv1.2,TLSv1.3
ssl_cipher = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256
require_secure_transport = ON

# data at rest: file_key_management plugin, keys provisioned by the db-keys role
plugin_load_add = file_key_management
file_key_management_filename = /etc/mysql/encryption/keyfile.enc
file_key_management_filekey = FILE:/etc/mysql/encryption/keyfile.key
file_key_management_encryption_algorithm = AES_CTR
innodb_checksum_algorithm = full_crc32
innodb_encrypt_tables = ON
innodb_encrypt_log = ON

# replication to db-inv-ord2
server_id = 21
log_bin = /var/lib/mysql/binlog/mariadb-bin
binlog_format = ROW
binlog_checksum = CRC32
expire_logs_days = 10
