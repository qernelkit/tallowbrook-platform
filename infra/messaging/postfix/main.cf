# mx1: Postfix outbound relay for application mail (notifications, invoices, statements).
# App hosts submit over STARTTLS on port 25; mail is signed by OpenDKIM on 127.0.0.1:8891.
compatibility_level = 3.6
myhostname = mx1.tallowbrook.example
mydomain = tallowbrook.example
myorigin = $mydomain
mydestination =
inet_interfaces = all
inet_protocols = ipv4
mynetworks = 127.0.0.0/8 10.20.0.0/16
relayhost =
alias_maps =
local_recipient_maps =
smtpd_banner = $myhostname ESMTP
biff = no
append_dot_mydomain = no
message_size_limit = 26214400
export_environment = TZ MAIL_CONFIG LANG
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject

# inbound from the app hosts
smtpd_tls_cert_file = /etc/tallowbrook/pki/services/smtp.crt
smtpd_tls_key_file = /etc/tallowbrook/pki/services/smtp.key
smtpd_tls_security_level = encrypt
smtpd_tls_mandatory_protocols = >=TLSv1.2
smtpd_tls_mandatory_ciphers = high
smtpd_tls_loglevel = 1

# outbound: DANE where the receiving domain publishes TLSA, opportunistic elsewhere
smtp_tls_security_level = dane
smtp_dns_support_level = dnssec
smtp_tls_mandatory_protocols = >=TLSv1.2
transport_maps = hash:/etc/postfix/transport
smtp_tls_loglevel = 1

tls_high_cipherlist = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305
tls_random_source = dev:/dev/urandom

smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = $smtpd_milters
milter_default_action = accept
