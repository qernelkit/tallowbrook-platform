# -*- text -*-
# FreeRADIUS 3.2 (radius-ord1): EAP-TLS only, for wired 802.1X on the core switches.
# Laptops and depot handhelds present device certificates from the E2 issuing CA.
eap {
	default_eap_type = tls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = /etc/tallowbrook/pki/services/radius-eap.key
		certificate_file = /etc/tallowbrook/pki/services/radius-eap.crt
		ca_file = /etc/tallowbrook/pki/ca/issuing-ec.crt
		tls_min_version = "1.2"
		tls_max_version = "1.3"
		cipher_list = "ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256"
		ecdh_curve = "secp384r1"
		check_crl = no
		check_cert_issuer = no
		cache {
			enable = no
		}
		verify {
		}
	}

	tls {
		tls = tls-common
	}
}
