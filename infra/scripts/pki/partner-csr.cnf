# openssl req settings for partner client-certificate requests
# (issue-internal-certs.sh partner-csr). The subject CN is set per partner.

[ req ]
default_bits       = 3072
default_md         = sha256
prompt             = no
distinguished_name = partner_dn
req_extensions     = partner_ext

[ partner_dn ]
C  = US
O  = Tallowbrook Logistics
OU = Partner Integrations
CN = partner-client.tallowbrook.example

[ partner_ext ]
keyUsage         = critical, digitalSignature
extendedKeyUsage = clientAuth
