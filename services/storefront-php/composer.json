{
    "name": "tallowbrook/storefront",
    "description": "Merchant storefront: checkout, parcel tracking, gift cards and merchant tools",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "illuminate/encryption": "13.35.0",
        "illuminate/hashing": "13.35.0",
        "illuminate/events": "13.35.0",
        "illuminate/http": "13.35.0",
        "illuminate/routing": "13.35.0",
        "phpseclib/phpseclib": "3.0.57",
        "hashids/hashids": "5.0.2",
        "firebase/php-jwt": "7.1.1",
        "lcobucci/jwt": "5.6.0",
        "paragonie/halite": "5.1.4",
        "defuse/php-encryption": "2.4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
