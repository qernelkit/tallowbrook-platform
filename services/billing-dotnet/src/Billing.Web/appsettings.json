{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "portal.tallowbrook.example;billing.tallowbrook.example",
  "Kestrel": {
    "Endpoints": {
      "Portal": {
        "Url": "https://*:8443"
      }
    },
    "Certificates": {
      "Default": {
        "Path": "/etc/tallowbrook/pki/services/portal-2016.crt",
        "KeyPath": "/etc/tallowbrook/pki/services/portal-2016.key"
      }
    }
  },
  "Auth": {
    "Authority": "https://id.tallowbrook.example",
    "Audience": "billing-api"
  },
  "DataProtection": {
    "KeysPath": "/var/lib/tallowbrook/billing/keys"
  },
  "Documents": {
    "RootPath": "/var/lib/tallowbrook/billing/documents"
  },
  "InvoiceLinks": {
    "Lifetime": "7.00:00:00",
    "PublicBase": "https://portal.tallowbrook.example/"
  },
  "PayLinks": {
    "Lifetime": "14.00:00:00"
  },
  "Payments": {
    "BaseAddress": "https://payments.tallowbrook.example/",
    "ClientCertificatePath": "/etc/tallowbrook/pki/keystores/payments.p12",
    "ServerCertificatePath": "/etc/tallowbrook/pki/services/payments.crt",
    "MandateKeyId": "alias/payments-vault-mandates",
    "AwsRegion": "eu-central-1"
  },
  "ExchangeRates": {
    "FeedUrl": "https://rates.tallowbrook.example/eurofxref-daily.xml",
    "CacheFor": "06:00:00"
  },
  "FinanceDirectory": {
    "Server": "dc01.corp.tallowbrook.example",
    "BaseDn": "DC=corp,DC=tallowbrook,DC=example",
    "GroupPrefix": "FIN-"
  },
  "Disputes": {
    "EvidencePath": "/var/lib/tallowbrook/billing/disputes",
    "RecipientCertificatePath": "/run/secrets/disputes-recipient.crt",
    "MaxUploadBytes": 26214400
  },
  "Archive": {
    "KekName": "billing-archive-kek",
    "ManifestKeyName": "billing-archive-signing",
    "Directory": "/var/lib/tallowbrook/billing/archive",
    "RunAtUtc": "01:30"
  },
  "EInvoicing": {
    "SigningCertificatePath": "/run/secrets/einvoice-signing.pfx",
    "SellerVatId": "DE811907980",
    "SellerName": "Tallowbrook Logistics GmbH",
    "OutboxPath": "/var/lib/tallowbrook/billing/einvoice-outbox"
  }
}
