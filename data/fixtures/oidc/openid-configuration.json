{
  "issuer": "https://id.tallowbrook.example",
  "authorization_endpoint": "https://id.tallowbrook.example/oauth2/authorize",
  "token_endpoint": "https://id.tallowbrook.example/oauth2/token",
  "userinfo_endpoint": "https://id.tallowbrook.example/oauth2/userinfo",
  "jwks_uri": "https://id.tallowbrook.example/.well-known/jwks.json",
  "end_session_endpoint": "https://id.tallowbrook.example/oauth2/logout",
  "revocation_endpoint": "https://id.tallowbrook.example/oauth2/revoke",
  "response_types_supported": ["code"],
  "response_modes_supported": ["query", "form_post"],
  "grant_types_supported": ["authorization_code", "refresh_token", "client_credentials"],
  "subject_types_supported": ["public"],
  "scopes_supported": ["openid", "profile", "email", "offline_access", "shipments:read", "tracking:read"],
  "id_token_signing_alg_values_supported": ["RS256", "ES256", "EdDSA"],
  "token_endpoint_auth_methods_supported": ["private_key_jwt", "client_secret_basic"],
  "token_endpoint_auth_signing_alg_values_supported": ["ES256", "PS256"],
  "code_challenge_methods_supported": ["S256"],
  "claims_supported": ["sub", "iss", "aud", "exp", "iat", "email", "email_verified", "name", "depot"],
  "frontchannel_logout_supported": true,
  "request_parameter_supported": false
}
